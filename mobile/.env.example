EXPO_PUBLIC_API_URL=https://www.rfacto.com

# Client OAuth Web (type 3) — déjà utilisé par l’app Android. Pas un secret.
# Google Cloud → Identifiants → ce client Web → URI de redirection autorisées :
#   https://auth.expo.io/@ndom2504/rfacto
#   https://www.rfacto.com/api/auth/google/callback
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=719915776201-m06tnpccblacg8tro797tca4q0mi93rd.apps.googleusercontent.com

# App Store / EAS iOS : créer un client OAuth iOS (bundle com.rfacto.app)
# et coller l’ID ici + GOOGLE_IOS_CLIENT_ID sur Vercel.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# EAS Android : client OAuth Android dont le SHA-1 correspond au keystore EAS.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
