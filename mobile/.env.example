EXPO_PUBLIC_API_URL=https://www.rfacto.com

# Client OAuth Web (type 3) — déjà utilisé par l’app Android. Pas un secret.
# Google Cloud → Identifiants → ce client Web → URI de redirection autorisées :
#   https://auth.expo.io/@ndom2504/rfacto
#   https://www.rfacto.com/api/auth/google/callback
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=719915776201-m06tnpccblacg8tro797tca4q0mi93rd.apps.googleusercontent.com

# App Store / EAS iOS — obligatoire pour le Sign-In natif (impossible dans Expo Go).
# Google Cloud → Identifiants → Créer un client OAuth iOS :
#   Bundle ID = com.rfacto.app
# Coller l’ID ci-dessous, le même dans eas.json (env des profils), et GOOGLE_IOS_CLIENT_ID sur Vercel.
# Le scheme iOS (com.googleusercontent.apps.…) est dérivé automatiquement au prebuild.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# EAS Android : client OAuth Android (package com.rfacto.app + SHA-1 du keystore EAS).
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
