{
  "expo": {
    "name": "Rfacto",
    "slug": "rfacto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rfacto",
    "userInterfaceStyle": "light",
    "updates": {
      "enabled": false
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rfacto.app",
      "infoPlist": {
        "CFBundleDisplayName": "Rfacto",
        "CFBundleAllowMixedLocalizations": true,
        "NSContactsUsageDescription": "In retrouve vos proches déjà inscrits sur Rfacto.",
        "NSPhotoLibraryUsageDescription": "Rfacto joint des photos aux messages et aux annonces.",
        "NSCameraUsageDescription": "Rfacto joint des photos aux messages et aux annonces.",
        "NSMicrophoneUsageDescription": "Rfacto enregistre des notes vocales et passe des appels dans Messages."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.rfacto.app",
      "adaptiveIcon": {
        "backgroundColor": "#0f6b4c",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-contacts",
        {
          "contactsPermission": "In retrouve vos proches déjà inscrits sur Rfacto."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Rfacto joint des photos aux messages et aux annonces.",
          "cameraPermission": "Rfacto joint des photos aux messages et aux annonces."
        }
      ],
      "expo-document-picker",
      [
        "expo-audio",
        {
          "microphonePermission": "Rfacto enregistre des notes vocales et passe des appels dans Messages.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0f6b4c"
        }
      ],
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      "expo-status-bar",
      "expo-font",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#28541D",
          "sounds": ["./assets/sounds/rfacto_notify.wav"],
          "defaultChannel": "rfacto_alerts_v3",
          "enableBackgroundRemoteNotifications": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "d8977989-e19b-4dfa-92e3-25e47b779597"
      },
      "googleWebClientId": "719915776201-m06tnpccblacg8tro797tca4q0mi93rd.apps.googleusercontent.com"
    },
    "owner": "ndom2504"
  }
}
