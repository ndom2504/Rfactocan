generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SENDER
  TRAVELER
  BOTH
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum TripStatus {
  OPEN
  FULL
  COMPLETED
  CANCELLED
}

enum TransportMode {
  AIR
  SEA
  RAIL
  ROAD
}

enum RequestStatus {
  OPEN
  MATCHED
  CLOSED
  CANCELLED
}

/// Type de besoin client (formulaire Commander).
enum OrderNeedType {
  PARCEL
  SERVICE
  PRODUCT
  /// Demandeur d'emploi — profil candidature
  JOB_SEEK
  /// Employeur — offre d'emploi
  JOB_OFFER
}

enum Urgency {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum BookingStatus {
  PROPOSED
  AWAITING_PAYMENT
  ACCEPTED
  HANDED_OVER
  IN_TRANSIT
  DELIVERED
  CANCELLED
  REFUSED
}

enum KycStatus {
  NONE
  PENDING
  VERIFIED
  FAILED
  REQUIRES_INPUT
}

/// Manual ID document review (fallback when Stripe Identity fails)
enum ManualIdDocStatus {
  NONE
  SUBMITTED
  APPROVED
  REJECTED
}

/// User application to become a Rfacto ambassador
enum AmbassadorRequestStatus {
  NONE
  PENDING
  REJECTED
}

enum PaymentStatus {
  REQUIRES_PAYMENT
  AUTHORIZED
  CAPTURED
  CANCELLED
  REFUNDED
  FAILED
}

/// Service payment request (provider → client after DM / listing deal)
enum ServicePayStatus {
  AWAITING_PAYMENT
  AWAITING_CONFIRMATION
  PAID
  DELIVERED
  FULFILLED
  CANCELLED
  EXPIRED
}

/// How the client pays a service invoice
enum ServicePayMethod {
  CARD
  INTERAC
  MOBILE
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum ShopStatus {
  DRAFT
  OPEN
  CLOSED
}

enum ShopOrderStatus {
  AWAITING_PAYMENT
  PAID
  FULFILLED
  CANCELLED
}

/// How the buyer organizes delivery after product payment
enum ShopDeliveryMode {
  NONE
  MATCH_ONLY
  PARCEL_PAID
}

model Currency {
  id           String  @id @default(cuid())
  code         String  @unique
  name         String
  symbol       String
  exchangeRate Float   @default(1)
  active       Boolean @default(true)

  countries Country[]
}

model Language {
  id     String  @id @default(cuid())
  code   String  @unique
  name   String
  active Boolean @default(true)
}

model Country {
  id           String  @id @default(cuid())
  code         String  @unique
  name         String
  continent    String
  flagEmoji    String?
  currencyCode String?
  active       Boolean @default(true)

  currency Currency? @relation(fields: [currencyCode], references: [code])
  cities   City[]

  @@index([continent])
  @@index([name])
}

model City {
  id          String  @id @default(cuid())
  countryCode String
  name        String
  latitude    Float?
  longitude   Float?
  active      Boolean @default(true)

  country Country @relation(fields: [countryCode], references: [code], onDelete: Cascade)

  @@unique([countryCode, name])
  @@index([name])
}

model User {
  id                          String     @id @default(cuid())
  email                       String     @unique
  passwordHash                String?
  googleId                    String?    @unique
  displayName                 String
  avatarUrl                   String?
  /// Profile cover / banner image
  bannerUrl                   String?
  country                     String?
  phone                       String?
  language                    String     @default("fr")
  preferredCurrency           String     @default("CAD")
  bio                         String?
  role                        UserRole   @default(BOTH)
  status                      UserStatus @default(ACTIVE)
  verifiedAt                  DateTime?
  ratingAvg                   Float      @default(0)
  ratingCount                 Int        @default(0)
  completedDeliveries         Int        @default(0)
  stripeCustomerId            String?    @unique
  stripeConnectAccountId      String?    @unique
  stripeConnectChargesEnabled Boolean    @default(false)
  stripeConnectPayoutsEnabled Boolean    @default(false)
  kycStatus                   KycStatus  @default(NONE)
  kycSessionId                String?
  kycVerifiedAt               DateTime?
  /// Private URL of manually uploaded ID (admin review fallback)
  manualIdDocUrl              String?
  manualIdDocStatus           ManualIdDocStatus @default(NONE)
  manualIdDocUploadedAt       DateTime?
  /// Optional user note or admin rejection reason
  manualIdDocNote             String?
  /// Last presence heartbeat (for online/offline in chat)
  lastSeenAt                  DateTime?
  /// Last known GPS for nearby job alerts (Uber-style)
  lastLat                     Float?
  lastLng                     Float?
  lastLocationAt              DateTime?
  /// Opt-in for nearby job / service push alerts (default on)
  nearbyAlertsEnabled         Boolean    @default(true)
  /// Named ambassador by admin (keeps product role)
  isAmbassador                Boolean    @default(false)
  /// Unique agent code for invite links (/register?ref=CODE)
  agentCode                   String?    @unique
  /// Set once at signup when arriving via an active ambassador link
  referredById                String?
  /// User-submitted request to become ambassador
  ambassadorRequestStatus     AmbassadorRequestStatus @default(NONE)
  /// WhatsApp number provided with the ambassador request (admin contact)
  ambassadorWhatsapp          String?
  ambassadorRequestedAt       DateTime?
  /// User accepted the community publication charter (profile settings)
  publicationCharterAcceptedAt DateTime?
  createdAt                   DateTime   @default(now())
  updatedAt                   DateTime   @updatedAt

  referredBy       User?           @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals        User[]          @relation("UserReferrals")
  trips            Trip[]
  parcelRequests   ParcelRequest[]
  serviceListings  ServiceListing[]
  servicePaymentsAsProvider ServicePaymentRequest[] @relation("ServicePaymentProvider")
  servicePaymentsAsClient   ServicePaymentRequest[] @relation("ServicePaymentClient")
  shops            Shop[]
  shopOrdersAsBuyer ShopOrder[]    @relation("ShopOrderBuyer")
  bookingsAsSender Booking[]       @relation("BookingSender")
  messages         Message[]
  directThreadsAsLow   DirectThread[] @relation("DirectThreadLow")
  directThreadsAsHigh  DirectThread[] @relation("DirectThreadHigh")
  directMessagesSent   DirectMessage[] @relation("DirectMessageSender")
  reviewsGiven     Review[]        @relation("ReviewsGiven")
  reviewsReceived  Review[]        @relation("ReviewsReceived")
  reportsFiled     Report[]        @relation("ReportsFiled")
  reportsAgainst   Report[]        @relation("ReportsAgainst")
  disputesOpened   Dispute[]       @relation("DisputesOpened")
  disputesAgainst  Dispute[]       @relation("DisputesAgainst")
  passwordResets   PasswordResetToken[]
  loginOtps        LoginOtp[]
  notifications    Notification[]
  deviceTokens     DeviceToken[]
  communityPosts   CommunityPost[]
  communityComments CommunityComment[]
  connectionsFrom  UserConnection[] @relation("ConnectionsFrom")
  connectionsTo    UserConnection[] @relation("ConnectionsTo")
  jobContactsSent     JobContact[] @relation("JobContactsSent")
  jobContactsReceived JobContact[] @relation("JobContactsReceived")
  meetProfile         MeetProfile?
  meetContactsSent    MeetContact[] @relation("MeetContactsSent")
  meetContactsReceived MeetContact[] @relation("MeetContactsReceived")
  heraldCommissions   HeraldCommission[] @relation("HeraldCommissions")
  heraldCommissionReferrals HeraldCommission[] @relation("HeraldCommissionReferral")
  heraldPayouts       HeraldPayout[]
  /// Canal de retrait par défaut pour le portefeuille (gains, commissions Héraut…)
  payoutChannel       String?
  /// Opérateur mobile / Interac (voir lib/user-intent PayoutProvider)
  payoutProvider      String?
  /// Téléphone e164 ou courriel Interac
  payoutIdentifier    String?
  /// Détails bancaires (Afrique + gros clients ; JSON léger)
  payoutBankName      String?
  payoutBankHolder    String?
  payoutBankAccount   String?
  /// IBAN / RIB si disponible
  payoutBankIban      String?
  walletWithdrawals   WalletWithdrawal[]

  @@index([referredById])
  @@index([ambassadorRequestStatus])
}

/// FCM (or other) push device tokens for Uber-style job alerts.
model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String   @default("ANDROID")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([platform])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// One-time login codes sent by email (2FA step after password).
model LoginOtp {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Trip {
  id            String     @id @default(cuid())
  userId        String
  fromCountry   String
  fromCity      String
  toCountry     String
  toCity        String
  departAt      DateTime
  arriveAt      DateTime?
  weightKg      Float
  pricePerKgCad Float
  currency      String     @default("CAD")
  /// If true, senders can counter-offer a price per kg; traveler may talk to several parties.
  priceNegotiable Boolean  @default(false)
  acceptedGoods String
  notes           String?
  transportMode   TransportMode @default(AIR)
  /// Specific vehicle/means within the mode (e.g. PLANE, TRUCK).
  transportType   String?
  airline         String?
  flightNumber    String?
  fromAirportCode String?
  toAirportCode   String?
  status          TripStatus @default(OPEN)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([fromCountry, toCountry, departAt])
  @@index([toCountry, toCity, departAt])
  @@index([userId])
  @@index([transportMode])
}

model ParcelRequest {
  id            String        @id @default(cuid())
  userId        String
  /// PARCEL (colis), SERVICE (prestation), PRODUCT (achat boutique).
  needType      OrderNeedType @default(PARCEL)
  /// Envoyer / recevoir (colis uniquement).
  orderSide     String?
  /// Catégorie métier (SERVICE).
  serviceCategory String?
  /// Type de prestation (SERVICE).
  serviceType   String?
  /// Catégorie boutique (PRODUCT).
  productCategory String?
  /// Emploi — intitulé poste / profil
  jobTitle        String?
  /// Emploi — secteur (jobs-catalog)
  jobSector       String?
  /// Emploi — expérience: junior | mid | senior | expert
  jobExperience   String?
  /// Emploi — diplôme / formation
  jobDiploma      String?
  /// Emploi — URL CV (PDF ou image)
  jobCvUrl        String?
  fromCountry   String
  fromCity      String
  toCountry     String
  toCity        String
  /// Poids colis ; 0 pour besoins service/produit/emploi.
  weightKg      Float         @default(0)
  description   String
  photosJson    String        @default("[]")
  urgency       Urgency       @default(NORMAL)
  declaredValue Float?
  desiredDate   DateTime?
  transportMode TransportMode?
  transportType String?
  status        RequestStatus @default(OPEN)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  shopOrder ShopOrder?
  jobContactsFrom JobContact[] @relation("JobContactFromRequest")
  jobContactsTo   JobContact[] @relation("JobContactToRequest")

  @@index([toCountry, toCity])
  @@index([userId])
  @@index([transportMode])
  @@index([needType, status])
  @@index([serviceCategory])
  @@index([productCategory])
  @@index([jobSector, status])
}

/// Premier contact emploi (employeur ↔ candidat) sans booking.
model JobContact {
  id             String   @id @default(cuid())
  fromUserId     String
  toUserId       String
  fromRequestId  String
  toRequestId    String
  message        String
  status         String   @default("SENT")
  createdAt      DateTime @default(now())

  fromUser    User          @relation("JobContactsSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      User          @relation("JobContactsReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  fromRequest ParcelRequest @relation("JobContactFromRequest", fields: [fromRequestId], references: [id], onDelete: Cascade)
  toRequest   ParcelRequest @relation("JobContactToRequest", fields: [toRequestId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toRequestId])
  @@index([toUserId, createdAt])
  @@index([fromUserId])
}

/// Offre de service collaboratif (hors flux colis Trip/ParcelRequest).
model ServiceListing {
  id            String   @id @default(cuid())
  userId        String
  category      String
  serviceType   String
  title         String
  description   String
  country       String
  city          String
  priceAmount   Float?
  priceUnit     String   @default("forfait")
  currency      String   @default("CAD")
  availableFrom DateTime?
  availableTo   DateTime?
  photosJson    String   @default("[]")
  /// Produits / articles (JSON string[]) — surtout pour la catégorie vente.
  productsJson  String   @default("[]")
  /// Site web / page du service (optionnel).
  websiteUrl    String?
  status        String   @default("OPEN")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentRequests ServicePaymentRequest[]

  @@index([category, country, city])
  @@index([serviceType])
  @@index([userId])
  @@index([status])
}

/// Provider invoices a client for a service (card / Interac / mobile)
model ServicePaymentRequest {
  id                      String           @id @default(cuid())
  listingId               String?
  threadId                String?
  providerId              String
  clientId                String
  title                   String
  description             String           @default("")
  amountCents             Int
  currency                String           @default("cad")
  platformFeeCents        Int              @default(0)
  providerPayoutCents     Int              @default(0)
  status                  ServicePayStatus @default(AWAITING_PAYMENT)
  payMethod               ServicePayMethod?
  /// e.g. orange_money, interac (when mobile/interac)
  payProvider             String?
  /// Phone / Interac email for off-platform transfer
  receiverHint            String?
  stripeCheckoutSessionId String?          @unique
  stripePaymentIntentId   String?          @unique
  clientMarkedPaidAt      DateTime?
  providerConfirmedAt     DateTime?
  paidAt                  DateTime?
  /// Announced fulfillment window after payment (calendar days)
  processingDays          Int              @default(3)
  /// New card invoices hold funds until the client confirms delivery
  escrowUntilConfirm      Boolean          @default(false)
  processingDueAt         DateTime?
  deliveredAt             DateTime?
  clientConfirmedAt       DateTime?
  stripeTransferId        String?          @unique
  releasedAt              DateTime?
  expiresAt               DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  listing  ServiceListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  provider User            @relation("ServicePaymentProvider", fields: [providerId], references: [id], onDelete: Cascade)
  client   User            @relation("ServicePaymentClient", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([providerId, createdAt])
  @@index([clientId, createdAt])
  @@index([threadId])
  @@index([status])
  @@index([listingId])
}

/// Virtual shop for multi-vendor product sales (Stripe Connect).
model Shop {
  id          String     @id @default(cuid())
  userId      String
  /// food_appliances | cosmetics | auto_parts | electronics
  category    String
  name        String
  description String     @default("")
  country     String
  city        String
  currency    String     @default("CAD")
  /// Wide banner image for the shop storefront
  coverUrl    String?
  /// Circular shop logo / profile bubble
  logoUrl     String?
  status      ShopStatus @default(DRAFT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  products ShopProduct[]
  orders   ShopOrder[]

  @@index([userId])
  @@index([category, status])
  @@index([status])
  @@index([country, city])
}

model ShopProduct {
  id              String    @id @default(cuid())
  shopId          String
  title           String
  description     String    @default("")
  priceCents      Int
  promoPriceCents Int?
  promoLabel      String?
  promoEndsAt     DateTime?
  /// Cover / primary image (first of photosJson) for list cards & legacy clients
  photoUrl        String?
  /// JSON string[] of product image URLs
  photosJson      String    @default("[]")
  /// Warranty text (esp. electronics) e.g. "12 mois"
  warranty        String?
  /// Available stock units (null = not tracked)
  stockQty        Int?
  /// Key strengths / selling points (esp. electronics)
  highlights      String?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shop   Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders ShopOrder[]

  @@index([shopId, active])
}

model ShopOrder {
  id                      String           @id @default(cuid())
  shopId                  String
  buyerId                 String
  productId               String
  quantity                Int              @default(1)
  unitPriceCents          Int
  amountCents             Int
  platformFeeCents        Int
  sellerPayoutCents       Int
  currency                String           @default("cad")
  status                  ShopOrderStatus  @default(AWAITING_PAYMENT)
  stripeCheckoutSessionId String?          @unique
  stripePaymentIntentId   String?          @unique
  /// Buyer delivery destination (after product payment)
  deliveryToCountry       String?
  deliveryToCity          String?
  deliveryMode            ShopDeliveryMode @default(NONE)
  /// Linked parcel request when mode = PARCEL_PAID
  parcelRequestId         String?          @unique
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  shop          Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  buyer         User           @relation("ShopOrderBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  product       ShopProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)
  parcelRequest ParcelRequest? @relation(fields: [parcelRequestId], references: [id], onDelete: SetNull)

  @@index([shopId, status])
  @@index([buyerId, createdAt])
  @@index([productId])
  @@index([status])
  @@index([deliveryMode])
}

model Booking {
  id                  String        @id @default(cuid())
  requestId           String
  tripId              String
  senderId            String
  /// Who started the mise en relation: SENDER (propose) or TRAVELER (apply)
  proposedBy          String        @default("SENDER")
  status              BookingStatus @default(PROPOSED)
  goodsCertified      Boolean       @default(false)
  customsAcknowledged Boolean       @default(false)
  /// Sender counter-offer (per kg, same currency as trip). Used when trip.priceNegotiable.
  offeredPricePerKg   Float?
  handoverToken       String?       @unique
  handoverCode        String?
  handoverExpiresAt   DateTime?
  handedOverAt        DateTime?
  /// Deadline to complete Stripe checkout (24h after AWAITING_PAYMENT)
  paymentExpiresAt    DateTime?
  cancelledReason     String?
  cancelledById       String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  request  ParcelRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  trip     Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  sender   User          @relation("BookingSender", fields: [senderId], references: [id], onDelete: Cascade)
  messages  Message[]
  reviews   Review[]
  payment   Payment?
  events    BookingEvent[]
  locations BookingLocation[]
  disputes  Dispute[]

  @@unique([requestId, tripId])
  @@index([senderId])
  @@index([status])
  @@index([handoverCode])
  @@index([paymentExpiresAt])
}

model BookingEvent {
  id        String   @id @default(cuid())
  bookingId String
  type      String
  status    String?
  label     String
  metaJson  String   @default("{}")
  actorId   String?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
}

model BookingLocation {
  id         String   @id @default(cuid())
  bookingId  String
  userId     String
  latitude   Float
  longitude  Float
  accuracyM  Float?
  label      String?
  createdAt  DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
}

model Payment {
  id                     String        @id @default(cuid())
  bookingId              String        @unique
  amountCadCents         Int
  platformFeeCents       Int
  travelerPayoutCents    Int
  currency               String        @default("cad")
  provider               String        @default("stripe")
  status                 PaymentStatus @default(REQUIRES_PAYMENT)
  stripePaymentIntentId  String?       @unique
  stripeCheckoutSessionId String?      @unique
  stripeTransferId       String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
}

/// Commission Héraut Réseau : part des frais plateforme sur paiements des filleuls.
enum HeraldCommissionSource {
  BOOKING
  SERVICE
  SHOP
}

enum HeraldCommissionStatus {
  /// Droit constaté (paiement capturé / service & shop payés)
  ACCRUED
  /// Bloqué (litige)
  HELD
  /// Annulé (remboursement)
  REVERSED
  /// Virement Stripe effectué
  PAID
  FAILED
}

model HeraldCommission {
  id               String                  @id @default(cuid())
  heraldId         String
  /// Filleul dont l'activité a généré la commission
  referralUserId   String
  sourceType       HeraldCommissionSource
  /// bookingId | servicePaymentId | shopOrderId
  sourceId         String
  platformFeeCents Int
  rewardBps        Int
  rewardCents      Int
  currency         String                  @default("cad")
  status           HeraldCommissionStatus  @default(ACCRUED)
  stripeTransferId String?
  payoutId         String?
  paidAt           DateTime?
  reversedAt       DateTime?
  note             String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  herald   User          @relation("HeraldCommissions", fields: [heraldId], references: [id], onDelete: Cascade)
  referral User          @relation("HeraldCommissionReferral", fields: [referralUserId], references: [id], onDelete: Cascade)
  payout   HeraldPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@unique([sourceType, sourceId, heraldId])
  @@index([heraldId, status])
  @@index([referralUserId])
  @@index([status, createdAt])
  @@index([payoutId])
}

/// Virement batch des commissions Héraut (Stripe Transfer).
model HeraldPayout {
  id               String   @id @default(cuid())
  heraldId         String
  amountCents      Int
  currency         String   @default("cad")
  stripeTransferId String?  @unique
  status           String   @default("PAID")
  note             String?
  createdAt        DateTime @default(now())

  herald       User               @relation(fields: [heraldId], references: [id], onDelete: Cascade)
  commissions  HeraldCommission[]

  @@index([heraldId, createdAt])
}

enum WalletWithdrawalStatus {
  REQUESTED
  APPROVED
  SENT
  FAILED
  CANCELLED
}

enum WalletWithdrawalSource {
  HERALD_COMMISSIONS
  EARNINGS
  MANUAL
}

/// Demande de retrait portefeuille → mobile money ou banque (traitement admin / API partenaire).
model WalletWithdrawal {
  id               String                   @id @default(cuid())
  userId           String
  amountCents      Int
  currency         String                   @default("cad")
  status           WalletWithdrawalStatus   @default(REQUESTED)
  source           WalletWithdrawalSource   @default(HERALD_COMMISSIONS)
  /// mobile | bank | stripe
  channel          String
  provider         String?
  /// Snapshot destinataire au moment de la demande
  destinationHint  String
  bankName         String?
  bankHolder       String?
  bankAccount      String?
  bankIban         String?
  note             String?
  adminNote        String?
  processedById    String?
  processedAt      DateTime?
  /// Liens optionnels vers un HeraldPayout Stripe
  heraldPayoutId   String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([source])
}

model CorridorConfig {
  id              String  @id @default(cuid())
  fromCountry     String
  toCountry       String
  currency        String  @default("cad")
  feeBps          Int     @default(1000)
  active          Boolean @default(true)
  paymentProvider String  @default("stripe")

  @@unique([fromCountry, toCountry])
  @@index([active])
}

model StripeEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  type        String
  processedAt DateTime @default(now())
}

model Message {
  id            String    @id @default(cuid())
  bookingId     String
  senderId      String
  body          String
  attachmentUrl String?
  /// When the other party opened / loaded the conversation containing this message
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@index([bookingId, readAt])
}

/// Affaire (réseau pro) ou amour — profil de rencontre privée.
enum MeetKind {
  BUSINESS
  ROMANCE
}

enum MeetGender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

enum MeetContactStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

/// Profil rencontre privée (1:1 User). Visible dans Annonces via matching.
model MeetProfile {
  id           String     @id @default(cuid())
  userId       String     @unique
  kind         MeetKind
  headline     String
  bio          String?
  myGender     MeetGender @default(UNSPECIFIED)
  birthYear    Int?
  city         String?
  country      String?
  seekGender   MeetGender @default(UNSPECIFIED)
  ageMin       Int?
  ageMax       Int?
  interests    String?
  photoUrl     String?
  /// false = photo masquée pour les autres (algorithme / fiches)
  photoVisible Boolean    @default(true)
  /// Publié dans le fil Rencontre privée
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([kind, active, updatedAt])
  @@index([country, city])
}

/// Demande de contact rencontre — la messagerie s’ouvre seulement si mutuelle (ACCEPTED).
model MeetContact {
  id         String            @id @default(cuid())
  fromUserId String
  toUserId   String
  message    String?
  status     MeetContactStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  fromUser User @relation("MeetContactsSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("MeetContactsReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  @@index([fromUserId, status])
}

/// Fil de discussion direct entre 2 utilisateurs (services / emploi / rencontre — pas colis).
/// userLowId / userHighId = ids triés pour unicité du couple.
model DirectThread {
  id              String    @id @default(cuid())
  userLowId       String
  userHighId      String
  /// SERVICE | JOB | MEET
  lastContextType String?
  lastContextId   String?
  lastMessageAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  userLow  User @relation("DirectThreadLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh User @relation("DirectThreadHigh", fields: [userHighId], references: [id], onDelete: Cascade)
  messages DirectMessage[]

  @@unique([userLowId, userHighId])
  @@index([lastMessageAt])
  @@index([userLowId])
  @@index([userHighId])
}

model DirectMessage {
  id            String    @id @default(cuid())
  threadId      String
  senderId      String
  body          String
  attachmentUrl String?
  /// SERVICE | JOB | MEET (contexte du message)
  contextType   String?
  contextId     String?
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  thread DirectThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User         @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([threadId, readAt])
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String
  fromUserId String
  toUserId   String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromUser User    @relation("ReviewsGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User    @relation("ReviewsReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([bookingId, fromUserId])
  @@index([toUserId])
}

model Report {
  id              String   @id @default(cuid())
  reporterId      String
  targetUserId    String
  /// Optional: report targets a community post (targetUserId = post author)
  communityPostId String?
  reason          String
  details         String?
  resolved        Boolean  @default(false)
  createdAt       DateTime @default(now())

  reporter      User           @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser    User           @relation("ReportsAgainst", fields: [targetUserId], references: [id], onDelete: Cascade)
  communityPost CommunityPost? @relation(fields: [communityPostId], references: [id], onDelete: Cascade)

  @@index([resolved])
  @@index([communityPostId])
}

model Dispute {
  id            String        @id @default(cuid())
  bookingId     String
  openedById    String
  againstUserId String
  reason        String
  details       String?
  status        DisputeStatus @default(OPEN)
  adminNote     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  resolvedAt    DateTime?

  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  openedBy    User    @relation("DisputesOpened", fields: [openedById], references: [id], onDelete: Cascade)
  againstUser User    @relation("DisputesAgainst", fields: [againstUserId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@index([status])
  @@index([openedById])
}

/// Feed posts: business, opportunities, community (pro network)
enum CommunityPostKind {
  BUSINESS
  OPPORTUNITY
  COMMUNITY
}

enum CommunityPostStatus {
  OPEN
  HIDDEN
  REMOVED
}

model CommunityPost {
  id              String              @id @default(cuid())
  authorId        String
  kind            CommunityPostKind
  title           String?
  body            String
  /// JSON array: [{ url, name, contentType, size }]
  attachmentsJson String              @default("[]")
  status          CommunityPostStatus @default(OPEN)
  viewCount       Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  author   User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments CommunityComment[]
  reports  Report[]

  @@index([createdAt])
  @@index([kind, createdAt])
  @@index([authorId, createdAt])
  @@index([status, createdAt])
}

model CommunityComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  /// Null = top-level comment; set = reply to another comment
  parentId  String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post    CommunityPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  CommunityComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies CommunityComment[] @relation("CommentReplies")

  @@index([postId, createdAt])
  @@index([parentId])
  @@index([authorId])
}

/// Follow / “Connecter” — follower subscribes to following’s community presence.
model UserConnection {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("ConnectionsFrom", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("ConnectionsTo", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([followerId])
}
